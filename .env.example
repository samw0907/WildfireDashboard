# Copy to .env and fill in real values. Never commit .env itself.

# --- Backend (Railway) ---
# Postgres connection string, provided by Railway once the Postgres service is added
DATABASE_URL=postgresql://user:password@host:port/dbname

# WorldPop hosted stats API key - optional, only for "larger queries and special
# functionality" per their docs; no self-serve registration exists, leave blank
WORLDPOP_API_KEY=

# Shared secret for the internal exposure-recompute trigger endpoint - never expose
# this publicly. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOMPUTE_API_KEY=

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# NIFC WFIGS ingestion cadence (minutes)
NIFC_INGESTION_INTERVAL_MINUTES=15

# Exposure recompute staleness fallback (hours) - recompute also triggers on new fire
# or material perimeter/acreage change, independent of this fallback
EXPOSURE_STALENESS_HOURS=24

# --- Frontend (Vite) ---
# Base URL of the deployed Railway backend API
VITE_API_BASE_URL=http://localhost:8000

# --- Intentionally NOT here ---
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_DEFAULT_REGION: only needed by the
# CI/CD frontend deploy step (S3 sync + CloudFront invalidation), not by the running
# app, so they live in GitHub Actions repo secrets, not .env. Use a dedicated
# narrowly-scoped IAM user for this project rather than reusing another project's keys.
# CDSE_USER / CDSE_PASSWORD: Sentinel-1/Copernicus credentials for Phase 2 (SAR
# confirmation). Phase 1 has no Sentinel-1 usage - add these when Phase 2 starts,
# not before.
