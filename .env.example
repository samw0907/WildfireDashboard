# Copy to .env and fill in real values. Never commit .env itself.

# --- Backend (Railway) ---
# Postgres connection string, provided by Railway once the Postgres service is added
DATABASE_URL=postgresql://user:password@host:port/dbname

# WorldPop hosted stats API key (register at https://www.worldpop.org/sdi/introapi/)
WORLDPOP_API_KEY=

# Shared secret for the internal exposure-recompute trigger endpoint - never expose this publicly
RECOMPUTE_API_KEY=

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# NIFC WFIGS ingestion cadence (minutes)
NIFC_INGESTION_INTERVAL_MINUTES=15

# Exposure recompute staleness fallback (hours) - recompute also triggers on new fire
# or material perimeter/acreage change, independent of this fallback
EXPOSURE_STALENESS_HOURS=24

# --- Frontend (Vite) ---
# Base URL of the deployed Railway backend API
VITE_API_BASE_URL=http://localhost:8000
