# Copy to .env and fill in real values. Never commit .env itself.

# --- Backend (Railway) ---
# Postgres connection string, provided by Railway once the Postgres service is added
DATABASE_URL=postgresql://user:password@host:port/dbname

# US Census Bureau ACS Data API key (population estimates) - free signup at
# https://api.census.gov/data/key_signup.html. Replaced WorldPop's hosted stats
# API (persistently unreliable task queue, see DECISIONS.md) - Census is also more
# authoritative for Phase 1's US-only scope. Note: only the population-attribute
# API needs this key; TIGERweb (block group geometries) needs no key at all.
CENSUS_API_KEY=

# Shared secret for the internal exposure-recompute trigger endpoint - never expose
# this publicly. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RECOMPUTE_API_KEY=

# Shared secret gating frontend-facing admin actions (mark-for-acquisition, confirm
# & proceed on SAR compute spend, etc.) - prompted once in the browser, not a login
# system. Generate the same way as RECOMPUTE_API_KEY, but keep it a separate value.
ADMIN_ACCESS_KEY=

# Copernicus Data Space Ecosystem credentials for Sentinel-1 SAR acquisition
# (Phase 2, now underway) - reuse the existing LAwildfireSAR project's CDSE account
# rather than creating a new one. NOTE: these are NOT read by the backend itself -
# candidate search needs no auth. They're only used by the sar-compute container,
# which reads them from an AWS Secrets Manager secret (wildfiredashboard/sar/cdse-credentials),
# not from this .env file - see sar-compute/README or DECISIONS.md.
CDSE_USER=
CDSE_PASSWORD=

# --- SAR compute dispatch (Phase D - AWS Batch on Fargate) ---
# AWS region the Batch compute environment/job queue/job definition live in
AWS_REGION=eu-north-1
# S3 bucket the sar-compute container syncs results to
SAR_RESULTS_BUCKET=wildfiredashboard-sar-results-497537671259
# Created once via `aws batch create-job-queue` / `register-job-definition` -
# see sar-compute/aws-iam-policy.json and DECISIONS.md for the full setup
SAR_BATCH_JOB_QUEUE=
SAR_BATCH_JOB_DEFINITION=
# This backend's own public URL (e.g. https://wildfiredashboard-production.up.railway.app) -
# passed into the Batch container so it can call back into this API for fire/acquisition data
WILDFIRE_API_BASE_URL=

# Backend needs its own AWS credentials here (unlike the sar-compute container, which
# uses its Fargate task's IAM role) - Railway isn't AWS, so there's no role for boto3's
# default chain to pick up. Use a NEW dedicated IAM user (e.g. wildfiredashboard-backend-runtime),
# NOT the wildfiredashboard-deployer setup user - scope it with
# sar-compute/aws-iam-policy-backend-runtime.json (submit_job/describe_jobs + read-only
# on the results bucket, nothing else).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS - comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# NIFC WFIGS ingestion cadence (minutes)
NIFC_INGESTION_INTERVAL_MINUTES=15

# Exposure recompute staleness fallback (hours) - recompute also triggers on new fire
# or material perimeter/acreage change, independent of this fallback.
# Temporarily 3 (was 24) to backfill population data faster after a Census
# API failure window - revert to 24 once the table's repopulated.
EXPOSURE_STALENESS_HOURS=3

# --- Frontend (Vite) ---
# Base URL of the deployed Railway backend API
VITE_API_BASE_URL=http://localhost:8000

# --- Intentionally NOT here ---
# The CI/CD frontend deploy step (S3 sync + CloudFront invalidation) uses its own
# AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY, scoped to a separate dedicated IAM user
# (wildfiredashboard-frontend-deploy) - those live in GitHub Actions repo secrets,
# not here. The AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY above (for SAR compute dispatch)
# are a DIFFERENT, separately-scoped IAM user - never reuse one purpose's keys for another.
