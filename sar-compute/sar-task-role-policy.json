{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SarResultsReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::wildfiredashboard-sar-results-497537671259"
    },
    {
      "Sid": "SarResultsObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::wildfiredashboard-sar-results-497537671259/*"
    }
  ]
}
